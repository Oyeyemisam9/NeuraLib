# Copy this file to .env and fill in real values.
# .env is already in .gitignore - never commit your actual .env file.

# A long random string used to sign session cookies. Any long random text works.
SECRET_KEY=change-this-to-a-long-random-string

# Gmail SMTP settings for sending verification / password-reset emails.
# MAIL_USERNAME is the full Gmail address you're sending from.
# MAIL_PASSWORD is a 16-character Gmail "App Password" - NOT your normal
# Gmail login password. See the setup steps for how to generate one.
MAIL_USERNAME=youraddress@gmail.com
MAIL_PASSWORD=your16charapppassword
MAIL_DEFAULT_SENDER=youraddress@gmail.com

# Optional: point at a different database file. Leave unset to use the
# default neuralib.db in the project folder for local development.
# On Render, this gets set automatically when you attach a Postgres
# database - you don't need to set it by hand there.
# DATABASE_URL=sqlite:///neuralib.db

# Optional: S3-compatible cloud storage (Backblaze B2, Cloudflare R2, AWS S3,
# or anything else that speaks the S3 API). Leave all four unset to keep
# using local disk (fine for local development). Set all four to switch
# material uploads/downloads to cloud storage - required in production,
# since Render's disk is wiped on every deploy.
# STORAGE_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET_NAME=
